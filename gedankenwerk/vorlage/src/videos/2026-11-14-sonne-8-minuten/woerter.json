 "zeilen": [
  {
   "s": 0.15,
   "e": 2.697,
   "text": "Die Sonne ist gerade verschwunden. Einfach weg."
  },
  {
   "s": 3.136,
   "e": 4.357,
   "text": "Und du merkst: nichts."
  },
  {
   "s": 4.935,
   "e": 8.114,
   "text": "Denn ihr Licht ist noch unterwegs, gut acht Minuten bis zur Erde."
  },
  {
   "s": 8.571,
   "e": 11.223,
   "text": "Bis dahin scheint sie ganz normal weiter. Noch."
  },
  {
   "s": 11.632,
   "e": 14.116,
   "text": "Auch ihre Schwerkraft ist nur so schnell wie das Licht."
  },
  {
   "s": 14.574,
   "e": 16.722,
   "text": "Die Erde kreist weiter, als wäre nichts passiert."
  },
  {
   "s": 17.322,
   "e": 18.88,
   "text": "Bis plötzlich alles dunkel wird."
  },
  {
   "s": 19.701,
   "e": 21.111,
   "text": "Mitten am Tag wird es Nacht."
  },
  {
   "s": 21.558,
   "e": 24.148,
   "text": "Der Mond verschwindet vom Himmel, Sterne tauchen auf."
  },
  {
   "s": 24.626,
   "e": 29.047,
   "text": "Viele Vögel verstummen, wie bei einer totalen Sonnenfinsternis, und es wird spürbar kühler."
  },
  {
   "s": 29.565,
   "e": 32.828,
   "text": "Gleichzeitig verliert die Erde ihren Halt und fliegt geradeaus ins All."
  },
  {
   "s": 33.354,
   "e": 34.701,
   "text": "Aber nur acht Minuten lang."
  },
  {
   "s": 35.05,
   "e": 37.808,
   "text": "Das sind gerade mal rund {700 Meter|siebenhundert Meter} Abweichung."
  },
  {
   "s": 38.193,
   "e": 39.94,
   "text": "Dann wird es schlagartig wieder hell."
  },
  {
   "s": 40.299,
   "e": 41.541,
   "text": "Und jetzt kommt das Verrückte:"
  },
  {
   "s": 42.141,
   "e": 44.583,
   "text": "Als es bei uns dunkel wurde, war die Sonne schon wieder da."
  }
 ],
