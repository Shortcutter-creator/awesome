 "zeilen": [
  {
   "s": 0.33,
   "e": 3.49,
   "text": "Ein einziges Haus für alle Menschen der Erde. Höher als der Mont Blanc!"
  },
  {
   "s": 4.01,
   "e": 7.71,
   "text": "{8,2 Milliarden|Acht Komma zwei Milliarden} Menschen, jeder bekommt {20|zwanzig} Quadratmeter."
  },
  {
   "s": 8.25,
   "e": 12.85,
   "text": "Auf einer Grundfläche so groß wie Paris bräuchte das Haus gut {1.500|fünfzehnhundert} Stockwerke."
  },
  {
   "s": 13.45,
   "e": 15.09,
   "text": "Fast fünfeinhalb Kilometer hoch!"
  },
  {
   "s": 15.95,
   "e": 20.31,
   "text": "Jedes Stockwerk ist so groß wie eine ganze Stadt, mit über fünf Millionen Bewohnern."
  },
  {
   "s": 20.97,
   "e": 22.53,
   "text": "Tageslicht gibt es nur am Rand."
  },
  {
   "s": 22.97,
   "e": 25.19,
   "text": "Weiter innen leuchten künstliche Himmel an der Decke."
  },
  {
   "s": 25.67,
   "e": 27.25,
   "text": "Einkaufen geht fast ohne Aufzug."
  },
  {
   "s": 27.71,
   "e": 30.77,
   "text": "Jede Etage hat eigene Supermärkte, Schulen und Ärzte."
  },
  {
   "s": 31.23,
   "e": 36.15,
   "text": "Alle hundert Stockwerke gibt es eine Sky-Lobby, mit Krankenhaus, Parks und Expressaufzügen."
  },
  {
   "s": 36.59,
   "e": 39.07,
   "text": "Vom Keller bis zum Dach dauert das rund fünf Minuten."
  },
  {
   "s": 39.59,
   "e": 40.87,
   "text": "Das größte Problem ist Wasser."
  },
  {
   "s": 41.31,
   "e": 47.95,
   "text": "Jeden Tag müssen Hunderte Milliarden Liter kilometerweit nach oben. Stufe für Stufe, über Pumpen und Zwischentanks."
  },
  {
   "s": 48.55,
   "e": 51.75,
   "text": "Das kostet mehrfach so viel Strom, wie ganz Deutschland verbraucht!"
  },
  {
   "s": 52.57,
   "e": 55.93,
   "text": "Immerhin fällt das Abwasser zurück nach unten und treibt dabei Turbinen an."
  },
  {
   "s": 56.29,
   "e": 58.61,
   "text": "Ganz oben ist der Luftdruck nur noch halb so hoch."
  },
  {
   "s": 59.11,
   "e": 62.57,
   "text": "Die obersten Etagen brauchen Druckluft, wie in einem Flugzeug."
  },
  {
   "s": 62.97,
   "e": 65.61,
   "text": "Und draußen? Der Rest der Erde wäre leer."
  },
  {
   "s": 66.21,
   "e": 67.89,
   "text": "Felder, Wälder, Wildnis."
  },
  {
   "s": 68.59,
   "e": 71.55,
   "text": "Lebensmittel kommen über riesige Lastenaufzüge ins Haus."
  },
  {
   "s": 72.15,
   "e": 74.81,
   "text": "Und jetzt du: Würdest du lieber ganz oben wohnen?"
  },
  {
   "s": 75.41,
   "e": 76.17,
   "text": "Oder ganz unten?"
  }
 ],
