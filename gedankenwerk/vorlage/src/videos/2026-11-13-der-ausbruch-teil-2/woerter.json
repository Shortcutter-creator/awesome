 "zeilen": [
  {
   "s": 0.15,
   "e": 5.329,
   "text": "Henrik steckt fest. Die Sirene heult. Und die Wärter sind schon im Gang."
  },
  {
   "s": 5.775,
   "e": 7.9,
   "text": "Draußen am Zaun bleibt Elias stehen."
  },
  {
   "s": 8.543,
   "e": 12.221,
   "text": "Marco packt ihn am Arm: Wir haben keine Zeit!"
  },
  {
   "s": 12.668,
   "e": 13.918,
   "text": "Doch Elias rennt zurück."
  },
  {
   "s": 14.507,
   "e": 18.668,
   "text": "Im Schacht reißt Henrik sich die Jacke vom Leib. Zentimeter für Zentimeter."
  },
  {
   "s": 19.15,
   "e": 23.025,
   "text": "Hinter ihm: Hunde. Ganz nah."
  },
  {
   "s": 23.825,
   "e": 25.61,
   "text": "Dann packt eine Hand sein Handgelenk."
  },
  {
   "s": 25.61,
   "e": 29.753,
   "text": "Es ist Elias. Mit einem Ruck zieht er ihn heraus."
  },
  {
   "s": 30.307,
   "e": 37.093,
   "text": "Zu viert rennen sie zum Zaun. Jonas klettert rüber. Dann Marco. Dann Henrik."
  },
  {
   "s": 37.539,
   "e": 40.432,
   "text": "Und Elias? Bleibt im Stacheldraht hängen."
  },
  {
   "s": 40.86,
   "e": 44.289,
   "text": "Der Scheinwerfer findet ihn. Teil drei kommt morgen."
  }
 ],
 "stille": [
  {
   "s": 23.025,
