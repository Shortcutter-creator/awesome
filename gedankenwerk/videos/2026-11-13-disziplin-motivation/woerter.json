 "zeilen": [
  {
   "s": 0.15,
   "e": 4.66,
   "text": "Zwei Männer. Zwei Stangen. Und ein Unterschied, der alles entscheidet."
  },
  {
   "s": 5.12,
   "e": 8.51,
   "text": "Links: Motivation. Rechts: Disziplin."
  },
  {
   "s": 9.09,
   "e": 10.05,
   "text": "Los geht's."
  },
  {
   "s": 10.53,
   "e": 15.39,
   "text": "Die Motivation startet wie eine Rakete. Ein Klimmzug nach dem anderen, voller Energie."
  },
  {
   "s": 16.01,
   "e": 18.95,
   "text": "Die Disziplin zieht ruhig. Immer im gleichen Tempo."
  },
  {
   "s": 19.43,
   "e": 21.87,
   "text": "Doch schon bald wird die Motivation langsamer."
  },
  {
   "s": 22.27,
   "e": 24.49,
   "text": "Die Arme brennen. Der Schwung ist weg."
  },
  {
   "s": 24.97,
   "e": 27.69,
   "text": "Und die Disziplin? Zieht einfach weiter."
  },
  {
   "s": 28.47,
   "e": 32.07,
   "text": "Dann lässt die Motivation los. Und setzt sich auf den Boden."
  },
  {
   "s": 33.07,
   "e": 34.71,
   "text": "Die Disziplin zieht immer noch."
  },
  {
   "s": 35.58,
   "e": 36.86,
   "text": "Und hat längst mehr geschafft."
  },
  {
   "s": 37.67,
   "e": 40.98,
   "text": "Motivation ist ein Gefühl. Sie bringt dich an den Start."
  },
  {
   "s": 41.61,
   "e": 44.72,
   "text": "Disziplin ist eine Entscheidung. Sie bringt dich ans Ziel."
  },
  {
   "s": 45.2,
   "e": 49.58,
   "text": "Am Ende zählt nicht, wie schnell du anfängst. Sondern dass du weitermachst."
  }
 ],
 "stille": [
  {
