 "zeilen": [
  {
   "s": 0.25,
   "e": 2.83,
   "text": "Du fährst {100|hundert} und legst den Ganghebel auf R."
  },
  {
   "s": 3.22,
   "e": 4.7,
   "text": "Geht jetzt der Motor kaputt?"
  },
  {
   "s": 5.7,
   "e": 8.18,
   "text": "Bei den meisten Autos passiert: fast nichts."
  },
  {
   "s": 8.68,
   "e": 12.98,
   "text": "Ein Ford mit Automatik wurde bei {113 km/h|hundertdreizehn Kilometern pro Stunde} getestet."
  },
  {
   "s": 13.36,
   "e": 16.17,
   "text": "Das Einzige, was anging, war die Rückfahrkamera."
  },
  {
   "s": 16.55,
   "e": 19.93,
   "text": "Denn ein Schutz schaltet das Getriebe einfach in den Leerlauf."
  },
  {
   "s": 19.93,
   "e": 22.94,
   "text": "Beim Schaltgetriebe sitzt eine Sperre vor dem R."
  },
  {
   "s": 23.21,
   "e": 24.53,
   "text": "Und dahinter wird es spannend."
  },
  {
   "s": 24.87,
   "e": 28.59,
   "text": "Im Getriebe kehrt ein zusätzliches Zahnrad die Drehrichtung um."
  },
  {
   "s": 28.85,
   "e": 33.26,
   "text": "Dieses Zahnrad ist meist nicht synchronisiert. Es wird einfach hineingeschoben."
  },
  {
   "s": 33.68,
   "e": 36.11,
   "text": "Das klappt nur, wenn die Wellen stillstehen."
  },
  {
   "s": 36.44,
   "e": 39.32,
   "text": "Bei Tempo drehen sie aber. Die Zähne krachen aufeinander."
  },
  {
   "s": 39.73,
   "e": 44.55,
   "text": "Ein Youtuber hat es in einem alten Pick-up trotzdem erzwungen. Mit beiden Händen."
  },
  {
   "s": 44.99,
   "e": 47.65,
   "text": "Die Hinterräder blockierten. Das Heck brach aus."
  },
