 "zeilen": [
  {
   "s": 0.15,
   "e": 2.97,
   "text": "Du fährst auf der Autobahn und auf einmal gibt es Stau."
  },
  {
   "s": 3.31,
   "e": 6.89,
   "text": "Nach {15|fünfzehn} Minuten Warten verschwindet der Stau… einfach so."
  },
  {
   "s": 7.67,
   "e": 9.17,
   "text": "Ohne Unfall oder Baustelle."
  },
  {
   "s": 9.87,
   "e": 10.67,
   "text": "Wie kann das sein?"
  },
  {
   "s": 11.31,
   "e": 13.15,
   "text": "Der Grund ist ein einziges Auto."
  },
  {
   "s": 13.53,
   "e": 16.23,
   "text": "Der Verkehr ist dicht, der Fahrer bremst nur ein bisschen."
  },
  {
   "s": 16.7,
   "e": 20.72,
   "text": "Der Fahrer dahinter reagiert etwas zu spät und bremst etwas stärker."
  },
  {
   "s": 21.12,
   "e": 22.14,
   "text": "Der Nächste noch stärker."
  },
  {
   "s": 22.56,
   "e": 24.28,
   "text": "Bis ganz hinten jemand komplett stehen muss."
  },
  {
   "s": 24.88,
   "e": 25.92,
   "text": "Das ist eine Stauwelle."
  },
  {
   "s": 26.3,
   "e": 28.86,
   "text": "Vorne fahren die Autos raus, hinten kommen neue dazu."
  },
  {
   "s": 29.18,
   "e": 34.28,
   "text": "So wandert der Stau rückwärts, gegen die Fahrtrichtung, mit etwa {15 km/h|fünfzehn Kilometern pro Stunde}."
  },
  {
   "s": 34.76,
   "e": 40.62,
   "text": "In Japan haben Forscher das getestet: {22|zweiundzwanzig} Autos auf einem Kreis, alle sollten gleichmäßig fahren."
  },
  {
   "s": 41.1,
   "e": 44.52,
   "text": "Nach wenigen Minuten gab es trotzdem Stau, ganz ohne Hindernis."
  },
  {
   "s": 45.06,
   "e": 46.38,
   "text": "Deshalb kannst du etwas tun."
  },
  {
   "s": 46.74,
   "e": 50.26,
   "text": "Halte Abstand, fahr gleichmäßig und spar dir das ständige Spurwechseln."
  },
  {
   "s": 50.56,
   "e": 53.52,
   "text": "So kann ein Bremser auslaufen, bevor daraus eine Welle wird."
  },
  {
   "s": 53.84,
   "e": 56.16,
   "text": "Der beste Stau ist der, den du nie verursachst."
  }
 ],
