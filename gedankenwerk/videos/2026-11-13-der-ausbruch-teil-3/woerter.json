 "zeilen": [
  {
   "s": 0.15,
   "e": 5.57,
   "text": "Elias hängt im Stacheldraht. Der Scheinwerfer blendet ihn. Und die Hunde kommen näher."
  },
  {
   "s": 5.9,
   "e": 7.06,
   "text": "Henrik klettert zurück."
  },
  {
   "s": 7.48,
   "e": 10.06,
   "text": "Mit bloßen Händen biegt er den Draht auseinander."
  },
  {
   "s": 10.53,
   "e": 13.3,
   "text": "Blut an seinen Fingern. Aber Elias ist frei."
  },
  {
   "s": 13.78,
   "e": 16.19,
   "text": "Sie springen. Landen hart. Und laufen."
  },
  {
   "s": 16.57,
   "e": 19.03,
   "text": "Der Wald ist nur zweihundert Meter entfernt."
  },
  {
   "s": 19.39,
   "e": 22.75,
   "text": "Hinter ihnen bellen die Hunde. Vor ihnen: Dunkelheit."
  },
  {
   "s": 23.12,
   "e": 25.89,
   "text": "Dann sind sie im Wald. Und alles wird still."
  },
  {
   "s": 27.09,
   "e": 30.34,
   "text": "Vier Männer. Ein Plan. Keiner wurde zurückgelassen."
  },
  {
   "s": 30.73,
   "e": 33.63,
   "text": "Am Morgen findet der Wärter nur einen Zettel auf dem Bett."
  },
  {
   "s": 33.93,
   "e": 36.91,
   "text": "Darauf steht: Neunzig Sekunden haben gereicht."
  },
  {
   "s": 37.23,
   "e": 38.69,
   "text": "Folg mir für die nächste Geschichte."
  }
 ],
