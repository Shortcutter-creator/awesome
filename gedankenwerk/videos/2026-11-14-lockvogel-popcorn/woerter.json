 "zeilen": [
  {
   "s": 0.15,
   "e": 3.464,
   "text": "Mit diesem Trick geben viele Menschen mehr Geld aus, ohne es zu merken."
  },
  {
   "s": 3.85,
   "e": 6.402,
   "text": "Du stehst im Kino und siehst drei Größen."
  },
  {
   "s": 6.881,
   "e": 7.777,
   "text": "Welche würdest du nehmen?"
  },
  {
   "s": 9.277,
   "e": 11.906,
   "text": "Die kleine Packung kostet fast so viel wie die mittlere."
  },
  {
   "s": 12.335,
   "e": 16.123,
   "text": "Nur ein Euro mehr, und du bekommst deutlich mehr Popcorn."
  },
  {
   "s": 16.575,
   "e": 19.356,
   "text": "Die große dagegen ist ganze {2,50 Euro|zwei Euro fünfzig} teurer."
  },
  {
   "s": 19.832,
   "e": 22.847,
   "text": "Also greifst du zur mittleren. Klingt vernünftig, oder?"
  },
  {
   "s": 23.271,
   "e": 24.772,
   "text": "Genau das ist der Plan."
  },
  {
   "s": 24.772,
   "e": 27.363,
   "text": "Die kleine Packung soll gar nicht verkauft werden."
  },
  {
   "s": 27.64,
   "e": 31.254,
   "text": "Sie ist nur da, damit die mittlere wie ein Schnäppchen wirkt."
  },
  {
   "s": 31.753,
   "e": 34.02,
   "text": "Psychologen nennen das den Lockvogel-Effekt."
  },
  {
   "s": 34.453,
   "e": 39.742,
   "text": "Der Abstand von Klein zu Mittel ist bewusst klein gehalten, der von Mittel zu Groß bewusst groß."
  },
  {
   "s": 40.14,
   "e": 43.798,
   "text": "So landen viele in der Mitte und zahlen mehr, als sie eigentlich wollten."
  },
  {
   "s": 44.248,
   "e": 47.908,
   "text": "Achte mal drauf: Kaffeegrößen, Abos, Handytarife."
  },
  {
   "s": 48.258,
   "e": 50.494,
   "text": "Überall steckt derselbe Trick dahinter."
  }
 ],
