 "zeilen": [
  {
   "s": 0.15,
   "e": 2.21,
   "text": "Wer ganz vorne einfädelt, ist ein Egoist?"
  },
  {
   "s": 2.61,
   "e": 4.46,
   "text": "Falsch! Genau das ist richtig."
  },
  {
   "s": 4.98,
   "e": 5.8,
   "text": "Und sogar Pflicht."
  },
  {
   "s": 6.26,
   "e": 8.78,
   "text": "Eine zweispurige Straße, vorne eine Baustelle."
  },
  {
   "s": 9.3,
   "e": 10.34,
   "text": "Die rechte Spur endet."
  },
  {
   "s": 10.75,
   "e": 12.79,
   "text": "Jetzt fädeln alle schon früh ein."
  },
  {
   "s": 13.29,
   "e": 16.03,
   "text": "Die rechte Spur bleibt leer, alles drängt sich auf eine."
  },
  {
   "s": 16.57,
   "e": 19.65,
   "text": "Beim Wechseln wird gebremst, dahinter bremsen alle anderen auch."
  },
  {
   "s": 19.97,
   "e": 21.73,
   "text": "Der Stau wächst und wächst nach hinten."
  },
  {
   "s": 22.19,
   "e": 25.21,
   "text": "Und jetzt nutzen alle beide Spuren bis ganz nach vorne."
  },
  {
   "s": 25.72,
   "e": 30.64,
   "text": "Erst direkt an der Engstelle geht es abwechselnd rein: einer links, einer rechts, wie ein Reißverschluss."
  },
  {
   "s": 31.04,
   "e": 34.32,
   "text": "Der Stau ist nur etwa halb so lang, weil beide Spuren genutzt werden."
  },
  {
   "s": 34.72,
   "e": 37.74,
   "text": "Und es geht gerechter zu, weil jeder abwechselnd dran ist."
  },
  {
   "s": 38.26,
   "e": 40.92,
   "text": "Also: Bis vorne fahren, abwechselnd einfädeln."
  },
  {
   "s": 41.3,
   "e": 42.38,
   "text": "Und lass den anderen rein."
  }
 ],
