 "zeilen": [
  {
   "s": 0.15,
   "e": 5.704,
   "text": "Vier Männer. Ein Plan. Und genau neunzig Sekunden, bis der Wärter zurückkommt."
  },
  {
   "s": 6.221,
   "e": 10.632,
   "text": "Drei Uhr nachts. Block C. Totenstille."
  },
  {
   "s": 11.257,
   "e": 14.007,
   "text": "Elias zieht das lose Gitter aus der Wand."
  },
  {
   "s": 14.436,
   "e": 18.561,
   "text": "Dahinter: ein Schacht. Kaum breiter als seine Schultern."
  },
  {
   "s": 19.15,
   "e": 26.114,
   "text": "Einer nach dem anderen kriechen sie hinein. Marco. Jonas. Und zuletzt der alte Henrik."
  },
  {
   "s": 26.114,
   "e": 29.489,
   "text": "Dann: Schritte. Direkt über ihnen."
  },
  {
   "s": 29.971,
   "e": 30.918,
   "text": "Niemand atmet."
  },
  {
   "s": 32.118,
   "e": 36.1,
   "text": "Ein Lichtkegel wandert durch die Zelle und bleibt auf den leeren Betten stehen."
  },
  {
   "s": 36.654,
   "e": 38.547,
   "text": "Und dann heult die Sirene los!"
  },
  {
   "s": 39.243,
   "e": 41.922,
   "text": "Drei von ihnen sind draußen. Aber Henrik steckt fest."
  },
  {
   "s": 42.511,
   "e": 44.94,
   "text": "Schafft er es? Folg mir für Teil zwei."
  }
 ],
 "stille": [
  {
   "s": 30.918,
   "dauer": 1.2
  }
 ]
}